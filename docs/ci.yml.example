name: CI
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      - run: npm ci
      - run: npm test
      - run: node -e "JSON.parse(require('fs').readFileSync('manifest.json','utf8'))"
      - run: sha256sum -c <<< "15fabce5b65898b32b03f5ed25e9f891a729ad4c0d6d877110a7744aa847a894  vendor/marked.min.js"
      - run: sha256sum -c <<< "c0845096a7c4a6741f362ac506c94c1c7d27dc603bcc1bf64a587f76f2dbe3a1  vendor/purify.min.js"
      - run: npm run package
      - uses: actions/upload-artifact@v4
        with: { name: extension, path: dist/drive-markdown-preview.zip }
